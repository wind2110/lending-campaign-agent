# Sao chep file nay thanh .env roi dien gia tri that. KHONG dua file .env len Git.

# --- Tai khoan nen tang GreenNode (chi can khi chay local; khi deploy len AgentBase Runtime
#     nen tang tu cap, KHONG dat cac bien GREENNODE_* trong file env khi deploy) ---
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=

# --- LLM (bat buoc de co insight tu dong; bat ky nha cung cap tuong thich OpenAI) ---
# GreenNode AI Platform: LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
# OpenAI:                LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Nguon du lieu hang ngay ---
# Google Sheet: dan ID hoac ca link. Sheet phai bat chia se "Bat ky ai co duong lien ket" (Nguoi xem).
# De trong = doc file Excel cuc bo o DATA_SOURCE_PATH.
GOOGLE_SHEET_ID=
# Duong dan file Excel cuc bo (mac dinh data/full_schema_mock.xlsx). Bo dau # de doi, KHONG de gia tri trong.
# DATA_SOURCE_PATH=data/full_schema_mock.xlsx

# --- Lich chay tu dong hang ngay (gio Viet Nam, mac dinh 8 = 8h sang). Bo dau # de doi, KHONG de gia tri trong. ---
# DAILY_CUTOFF_HOUR=8

# --- Lam moi thu cong (POST /api/refresh, header X-Refresh-Token). Thieu bien nay thi endpoint bi TAT. ---
# Tao: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REFRESH_TOKEN=
# TRUSTED_PROXY_HOPS=1

# --- Hoi dap voi AI tren Dashboard (tuy chon; moi cau hoi ton phi LLM). Bo dau # de doi, KHONG de gia tri trong. ---
# CHAT_MAX_PER_IP_PER_HOUR=30
# CHAT_MAX_PER_DAY=300
# CHAT_MAX_CONCURRENT=3

# --- Gui email tom tat hang ngay (tuy chon; can du ca 3 bien EMAIL_* moi gui) ---
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENTS=
# Dia chi Dashboard dua vao email (mac dinh http://localhost:8080). Bo dau # de doi, KHONG de gia tri trong.
# DASHBOARD_BASE_URL=http://localhost:8080
